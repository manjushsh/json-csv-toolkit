# npm configuration for json-csv-toolkit

# Use pnpm as the preferred package manager
package-manager=pnpm

# Registry configuration
registry=https://registry.npmjs.org/

# Security settings
audit-level=moderate
fund=false

# Package installation preferences
save-exact=false
save-prefix=^

# Publishing configuration
access=public

# Development settings
progress=true
loglevel=info

# Cache settings
cache-max=86400000

# Node.js version enforcement (requires Node 18+)
engine-strict=true

# Prevent installation of peer dependencies automatically
auto-install-peers=false

# Optional: Uncomment if you want to use a specific npm token for publishing
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}
